# Example configuration for RunPodManager. Copy to runpod_config.toml and adjust values for your account.

[manager]
mode = "direct"                # direct (RunPod API) or managed (platform API)
default_ttl_seconds = 1800
max_ttl_seconds = 3600
poll_interval_seconds = 10
readiness_timeout_seconds = 600
cloud_type = "SECURE"
# control_plane_base_url = "https://v2-rest.runpod.io/v2" # Override only for beta/dev smoke tests.
# user_agent = "your-app/runpod-integration"               # Must be a non-empty application UA.

[training_pods]
database_path = "${KESTREL_HOME}/state/runpod-training-pods.sqlite3"
poll_interval_seconds = 10
orphan_timeout_seconds = 90

[ollama_leases]
database_path = "${KESTREL_HOME}/state/runpod-ollama-leases.sqlite3"
poll_interval_seconds = 5
serverless_workers_max = 1
serverless_request_count = 1
serverless_execution_timeout_ms = 300000
serverless_flashboot = "FLASHBOOT"
http_timeout_seconds = 300
quote_ttl_seconds = 60
# Operator estimates must come from measured cold-start telemetry. They are
# quote inputs and a request with a tighter readiness deadline is refused.
serverless_estimated_ready_seconds = 180
pod_estimated_ready_seconds = 300

[profiles.ollama]
name = "Private Ollama"
task_type = "ollama"
image_name = "${RUNPOD_OLLAMA_IMAGE}"
container_disk_gb = 40
volume_gb = 0
ports = ["11434/http"]
inference_port = 11434
inference_protocol = "http"
inference_base_path = "/"
pod_type = "private-ollama"
min_vram_gb = 24
min_cuda_version = "12.8"
gpu_count = 1
# Inference quotes require an exact region. List only data centers approved for
# the workload's residency/privacy policy.
allowed_data_center_ids = ["US-TX-3"]
max_context_window = 32768

[profiles.ollama.env]
  # Comma-separated name:tag@sha256:<64 lowercase hex> entries. This trusted
  # operator policy is required and request data cannot expand or override it.
  KESTREL_OLLAMA_ALLOWED_MODELS = "${RUNPOD_OLLAMA_ALLOWED_MODELS}"
  # The provider owns PORT, health, requested-model, bearer, expiry, and mode.

[profiles.llm]
name = "Large-memory LLM"
task_type = "llm"
image_name = "runpod/kestrel-llm:latest"
container_disk_gb = 40
volume_gb = 0
ports = ["8000/http"]
inference_port = 8000
inference_protocol = "http"
inference_base_path = "/v1"
image_invoke_path = "/v1/completions"
default_model = "llama-3-70b-instruct"
pod_type = "dedicated-llm"
max_context_window = 32768
min_vram_gb = 80
min_cuda_version = "12.8"
max_cost_per_hr = 5.00
gpu_count = 1
readiness_timeout_seconds = 900

[profiles.llm.env]
  HF_TOKEN = "${HF_TOKEN}"
  KESTREL_PROFILE = "llm"

[profiles.image]
name = "Large-memory image generation"
task_type = "image"
image_name = "runpod/kestrel-flux:latest"
container_disk_gb = 80
volume_gb = 0
ports = ["9000/http"]
inference_port = 9000
inference_protocol = "http"
inference_base_path = "/invoke"
image_invoke_path = "/invoke"
default_model = "flux-dev"
pod_type = "dedicated-image"
max_context_window = 4096
min_vram_gb = 40
min_cuda_version = "12.8"
max_cost_per_hr = 3.00
gpu_count = 1

[profiles.image.env]
  KESTREL_PROFILE = "image"
